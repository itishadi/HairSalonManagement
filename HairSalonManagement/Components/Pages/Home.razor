@page "/"

<div class="text-center mb-5">
    <h1 class="display-4">Hair Salon Management</h1>
    <p class="lead">
        Manage services, stylists, customers and appointments in one place.
    </p>
</div>

<div class="row">

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Services</h4>
                <p>View and manage available salon services.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Stylists</h4>
                <p>Manage salon staff and their specialities.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Appointments</h4>
                <p>Create, update and manage bookings.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Customers</h4>
                <p>Keep track of customer information.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Reviews</h4>
                <p>View customer feedback and ratings.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h4>Dashboard</h4>
                <p>Get an overview of salon activity.</p>
            </div>
        </div>
    </div>

</div>