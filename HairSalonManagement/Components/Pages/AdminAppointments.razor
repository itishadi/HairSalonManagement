@page "/admin-appointments"
@rendermode InteractiveServer

@using HairSalonManagement.Data
@using HairSalonManagement.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

@inject ApplicationDbContext Db

<h3>Manage Appointments</h3>

<table class="table">

    <thead>
        <tr>
            <th>Date</th>
            <th>Service</th>
            <th>Stylist</th>
            <th>Status</th>
            <th>Change Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var appointment in appointments)
        {
            <tr>

                <td>
                    @appointment.AppointmentDate.ToShortDateString()
                </td>

                <td>
                    @appointment.Service?.Name
                </td>

                <td>
                    @appointment.Stylist?.FirstName
                    @appointment.Stylist?.LastName
                </td>

                <td>
                    @appointment.Status
                </td>

                <td>

                    <select @onchange="(e) => UpdateStatus(appointment, e.Value?.ToString())">

                        <option selected="@(appointment.Status == "Pending")">
                            Pending
                        </option>

                        <option selected="@(appointment.Status == "Confirmed")">
                            Confirmed
                        </option>

                        <option selected="@(appointment.Status == "Completed")">
                            Completed
                        </option>

                        <option selected="@(appointment.Status == "Cancelled")">
                            Cancelled
                        </option>

                    </select>

                </td>

            </tr>
        }

    </tbody>

</table>

@code {

    private List<Appointment> appointments = new();

    protected override void OnInitialized()
    {
        LoadAppointments();
    }

    private void LoadAppointments()
    {
        appointments = Db.Appointments
            .Include(a => a.Service)
            .Include(a => a.Stylist)
            .ToList();
    }

    private void UpdateStatus(Appointment appointment, string? status)
    {
        appointment.Status = status ?? "Pending";

        Db.SaveChanges();

        LoadAppointments();
    }
}