@page "/services"
@rendermode InteractiveServer

@using HairSalonManagement.Models
@using HairSalonManagement.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Admin")]

@inject HttpClient Http
@inject ApplicationDbContext Db

<h3>Services</h3>

<p>Services count: @services.Count</p>

<div class="mb-3">

    <SearchBox @bind-SearchText="searchText" />

    <input @bind="selectedCategory"
           @bind:event="oninput"
           placeholder="Filter Category" />

</div>

<hr />

<div class="mb-3">

    <input @bind="newService.Name" placeholder="Name" />

    <input @bind="newService.Description" placeholder="Description" />

    <input type="number"
           step="0.01"
           @bind="newService.Price"
           placeholder="Price" />

    <input type="number"
           @bind="newService.DurationMinutes"
           placeholder="Duration" />

    <input @bind="newService.Category"
           placeholder="Category" />

    @if (isEditing)
    {
        <button class="btn btn-warning"
                @onclick="SaveService">
            Update Service
        </button>

        <button class="btn btn-secondary"
                @onclick="CancelEdit">
            Cancel
        </button>
    }
    else
    {
        <button class="btn btn-primary"
                @onclick="SaveService">
            Add Service
        </button>
    }

</div>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-danger">@message</p>
}

<hr />

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Duration</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var service in FilteredServices)
        {
            <tr>
                <td>@service.Name</td>
                <td>@service.Price kr</td>
                <td>@service.DurationMinutes min</td>
                <td>@service.Category</td>

                <td>
                    <button class="btn btn-sm btn-warning"
                            @onclick="() => EditService(service)">
                        Edit
                    </button>

                    <button class="btn btn-sm btn-danger"
                            @onclick="() => DeleteService(service.ServiceId)">
                        Delete
                    </button>
                </td>
            </tr>
        }

    </tbody>
</table>

@code {

    private List<Service> services = new();

    private Service newService = new();

    private bool isEditing = false;

    private string message = "";

    private string searchText = "";

    private string selectedCategory = "";

    private IEnumerable<Service> FilteredServices =>
        services.Where(s =>
            (string.IsNullOrWhiteSpace(searchText) ||
             s.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(selectedCategory) ||
             (s.Category?.Contains(selectedCategory,
             StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override void OnInitialized()
    {
        LoadServices();
    }

    private void LoadServices()
    {
        services = Db.Services
            .OrderBy(s => s.Name)
            .ToList();
    }

    private void SaveService()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(newService.Name))
        {
            message = "Service name is required.";
            return;
        }

        if (newService.Price <= 0)
        {
            message = "Price must be greater than 0.";
            return;
        }

        if (newService.DurationMinutes <= 0)
        {
            message = "Duration must be greater than 0.";
            return;
        }

        if (newService.ServiceId == 0)
        {
            Db.Services.Add(newService);
        }

        Db.SaveChanges();

        newService = new Service();

        isEditing = false;

        LoadServices();
    }

    private void EditService(Service service)
    {
        newService = service;

        isEditing = true;
    }

    private void CancelEdit()
    {
        newService = new Service();

        isEditing = false;

        message = "";
    }

    private void DeleteService(int id)
    {
        var service = Db.Services.Find(id);

        if (service is null)
            return;

        Db.Services.Remove(service);

        Db.SaveChanges();

        LoadServices();

        if (newService.ServiceId == id)
        {
            CancelEdit();
        }
    }
}